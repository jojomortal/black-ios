 #include "kernel/memory.h"
 
 #include <algorithm>
+#include <cerrno>
 #include <cstring>
 #include <map>
 #include <mutex>
@@ -13,6 +14,11 @@
 #include <windows.h>
 #else
 #include <sys/mman.h>
+#ifdef __APPLE__
+#include <mach/mach.h>
